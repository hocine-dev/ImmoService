{
  "name": "immoservice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit/",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "sdk:generate": "openapi-generator-cli generate -i openapi.yaml -g typescript-fetch -o ./sdk --additional-properties=importFileExtension=.js",
    "pretest": "npm run sdk:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-slow-down": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "~3.2.7"
  }
}